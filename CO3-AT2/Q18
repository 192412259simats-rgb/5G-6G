clc;
clear;
close all;

% Satellite types
satellites = {'LEO','MEO','GEO'};

% Approximate orbital altitude in km
altitude = [1200 10000 35786];

% One-way propagation delay in milliseconds
delay = [4 33 119];

% Relative coverage radius in km
coverage = [1500 5000 12000];

% Relative throughput in Mbps
throughput = [1000 800 500];

% Display values
fprintf('Satellite Backhaul Comparison\n');
fprintf('---------------------------------------------\n');
fprintf('Type\tAltitude(km)\tDelay(ms)\tThroughput(Mbps)\n');

for i = 1:3
    fprintf('%s\t%d\t\t%d\t\t%d\n', ...
        satellites{i}, altitude(i), delay(i), throughput(i));
end

% Create comparison figure
figure;

subplot(2,2,1);
bar(altitude);
set(gca,'XTickLabel',satellites);
xlabel('Satellite Type');
ylabel('Altitude (km)');
title('Orbital Altitude');
grid on;

subplot(2,2,2);
bar(delay);
set(gca,'XTickLabel',satellites);
xlabel('Satellite Type');
ylabel('Delay (ms)');
title('Propagation Delay');
grid on;

subplot(2,2,3);
bar(coverage);
set(gca,'XTickLabel',satellites);
xlabel('Satellite Type');
ylabel('Coverage Radius (km)');
title('Coverage');
grid on;

subplot(2,2,4);
bar(throughput);
set(gca,'XTickLabel',satellites);
xlabel('Satellite Type');
ylabel('Throughput (Mbps)');
title('Relative Throughput');
grid on;

sgtitle('Comparative Architecture of LEO, MEO and GEO Backhaul');
